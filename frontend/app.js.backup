const API_BASE = "http://127.0.0.1:8000";

const state = {
    assets: [],
    loading: false
};

const elements = {
    totalAssets: document.getElementById("total-assets"),
    activeAssets: document.getElementById("active-assets"),
    maintenanceAssets: document.getElementById("maintenance-assets"),
    locations: document.getElementById("locations"),
    assetTableBody: document.getElementById("asset-table-body"),
    refreshButton: document.getElementById("refresh-assets"),
    apiStatus: document.getElementById("api-status")
};

function setApiStatus(message, online = true) {
    if (!elements.apiStatus) return;

    elements.apiStatus.textContent = message;
    elements.apiStatus.className = online ? "api-status online" : "api-status offline";
}

function updateDashboard() {
    const assets = state.assets;

    const active = assets.filter(
        asset => String(asset.status).toLowerCase() === "active"
    ).length;

    const maintenance = assets.filter(
        asset => String(asset.status).toLowerCase() === "maintenance"
    ).length;

    const locations = new Set(
        assets
            .map(asset => asset.location)
            .filter(Boolean)
    ).size;

    if (elements.totalAssets) {
        elements.totalAssets.textContent = assets.length;
    }

    if (elements.activeAssets) {
        elements.activeAssets.textContent = active;
    }

    if (elements.maintenanceAssets) {
        elements.maintenanceAssets.textContent = maintenance;
    }

    if (elements.locations) {
        elements.locations.textContent = locations;
    }

    renderAssets();
}

function renderAssets() {
    if (!elements.assetTableBody) return;

    if (!state.assets.length) {
        elements.assetTableBody.innerHTML = `
            <tr>
                <td colspan="7" class="empty-state">
                    No assets found.
                </td>
            </tr>
        `;
        return;
    }

    elements.assetTableBody.innerHTML = state.assets.map(asset => `
        <tr>
            <td>${escapeHtml(asset.id ?? "")}</td>
            <td>${escapeHtml(asset.asset_code ?? "")}</td>
            <td>${escapeHtml(asset.name ?? "")}</td>
            <td>${escapeHtml(asset.asset_type ?? "")}</td>
            <td>
                <span class="status-badge status-${String(asset.status ?? "").toLowerCase()}">
                    ${escapeHtml(asset.status ?? "")}
                </span>
            </td>
            <td>${escapeHtml(asset.location ?? "-")}</td>
            <td>${escapeHtml(asset.owner ?? "-")}</td>
        </tr>
    `).join("");
}

function escapeHtml(value) {
    return String(value)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
}

async function loadAssets() {
    if (state.loading) return;

    state.loading = true;
    setApiStatus("SYNCING...", true);

    try {
        const response = await fetch(`${API_BASE}/api/v1/assets`);

        if (!response.ok) {
            throw new Error(`API returned ${response.status}`);
        }

        const data = await response.json();

        if (Array.isArray(data)) {
            state.assets = data;
        } else if (Array.isArray(data.assets)) {
            state.assets = data.assets;
        } else {
            state.assets = [];
        }

        updateDashboard();
        setApiStatus("LIVE • API CONNECTED", true);

    } catch (error) {
        console.error("ATUL API error:", error);
        setApiStatus("OFFLINE • API UNAVAILABLE", false);
    } finally {
        state.loading = false;
    }
}

if (elements.refreshButton) {
    elements.refreshButton.addEventListener("click", loadAssets);
}

loadAssets();

setInterval(loadAssets, 30000);
